# R8 rules, read by build.ps1 and build.sh. R8 drops the library code the app
# never reaches, which is most of AndroidX Tiles, ProtoLayout and the Kotlin
# standard library: about 1.7 MB of APK down to about 0.2 MB. The rules keeping
# the activities and services named in AndroidManifest.xml are generated by
# aapt2 at build time.

# Keep class names. A crash log then names real classes, and nothing that is
# looked up by name can be renamed out from under it. Costs about 8 KB.
-dontobfuscate

# From the AndroidX Tiles and ProtoLayout libraries' own rules: the protobuf
# runtime reads message fields by reflection, so they must survive shrinking.
-keepclassmembers class * extends androidx.wear.protolayout.protobuf.GeneratedMessageLite {
  <fields>;
}

# Classes the libraries mention but the tile never reaches, left out on purpose
# (see libraries.txt): annotations, PendingIntent clicks (androidx.core), the
# optional wear-sdk tile service, and dynamic-expression evaluation.
-dontwarn androidx.annotation.**
-dontwarn org.jetbrains.annotations.**
-dontwarn androidx.core.os.BundleCompat
-dontwarn com.google.wear.**
-dontwarn androidx.wear.protolayout.expression.pipeline.**
