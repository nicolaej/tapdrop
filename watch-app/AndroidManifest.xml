<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.tapdrop"
    android:versionCode="5"
    android:versionName="0.4.0">

    <uses-permission android:name="android.permission.NFC" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Location: used while a location item's share screen is open, and to read the
         connected Wi-Fi network's name when the user asks the Wi-Fi form to fill it in. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Copied from the AndroidX tiles library's manifest, since there is no manifest merger:
         lets TileService.getUpdater() find the tile host to ask for a redraw. -->
    <queries>
        <intent>
            <action android:name="androidx.wear.tiles.action.BIND_UPDATE_REQUESTER" />
        </intent>
    </queries>

    <uses-feature android:name="android.hardware.type.watch" />
    <uses-feature android:name="android.hardware.nfc.hce" android:required="true" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault">

        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <!-- Also from the tiles library: newer tile hosts are reached through it when present. -->
        <uses-library android:name="wear-sdk" android:required="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ShareActivity" android:exported="false" />
        <activity android:name=".EditActivity" android:exported="false" />
        <activity android:name=".LearnActivity" android:exported="false" />
        <!-- The Quick tap page. Exported so the tile host can open it when the tile is tapped.
             The tile opens it as a new task, and the empty affinity keeps that task apart from
             the app's own, so Back returns to the tile instead of to whichever TapDrop screen
             was left open. Opened from the home list, it stays in the app's task as before. -->
        <activity
            android:name=".OneTapActivity"
            android:exported="true"
            android:taskAffinity=""
            android:excludeFromRecents="true" />

        <service
            android:name=".TapDropTileService"
            android:label="@string/quick_tap_tile_name"
            android:description="@string/quick_tap_tile_description"
            android:icon="@mipmap/ic_launcher"
            android:exported="true"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@mipmap/ic_launcher" />
        </service>

        <!-- Answers NFC readers as an NFC Forum Type 4 tag holding one NDEF record. -->
        <service
            android:name=".NdefTagService"
            android:exported="true"
            android:permission="android.permission.BIND_NFC_SERVICE">
            <intent-filter>
                <action android:name="android.nfc.cardemulation.action.HOST_APDU_SERVICE" />
            </intent-filter>
            <meta-data
                android:name="android.nfc.cardemulation.host_apdu_service"
                android:resource="@xml/apdu_service" />
        </service>
    </application>
</manifest>
